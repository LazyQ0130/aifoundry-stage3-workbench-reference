{
  "name": "personal-knowledge-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "AIFoundry Stage 3 Reference —— AI 知识工作台",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && prisma migrate status && next build",
    "start": "next start",
    "test": "node --import tsx --test tests/reliability.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.26",
    "react": "19.0.8",
    "react-dom": "19.0.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "dotenv": "16.5.0",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "tsx": "4.23.15"
  },
  "overrides": {
    "postcss": "$postcss",
    "deepmerge-ts": "8.0.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
